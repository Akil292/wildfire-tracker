# PostgreSQL connection used by Drizzle and the migration command.
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB

# Used only by docker compose to configure the local PostGIS container.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Server-only secret for session-token hashing. Generate at least 32 random characters.
AUTH_SECRET=
